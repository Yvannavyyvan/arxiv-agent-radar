#!/usr/bin/env python3
"""
arXiv Cognitive Radar — Autonomous Ingestion & Extraction Engine
Target categories: cs.AI (Artificial Intelligence), cs.MA (Multi-Agent Systems), cs.CL (Computation & Language)
Uses the official arXiv REST/Atom API (http://export.arxiv.org/api/query)
Follows strict 3.0s politeness delay and zero-dependency standard library design.
"""

import sys
import time
import json
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from datetime import datetime

ATOM_NS = "{http://www.w3.org/2005/Atom}"
ARXIV_NS = "{http://arxiv.org/schemas/atom}"

class ArxivAgentRadar:
    BASE_URL = "http://export.arxiv.org/api/query"

    def __init__(self, categories=None, delay_seconds=3.0):
        self.categories = categories or ["cs.AI", "cs.MA", "cs.CL"]
        self.delay_seconds = delay_seconds

    def build_query(self, search_terms=None, max_results=20, sort_by="submittedDate", sort_order="descending"):
        cat_query = " OR ".join([f"cat:{cat}" for cat in self.categories])
        if search_terms:
            terms_query = " AND ".join([f'all:"{term}"' for term in search_terms])
            full_query = f"({cat_query}) AND ({terms_query})"
        else:
            full_query = cat_query

        params = {
            "search_query": full_query,
            "start": 0,
            "max_results": max_results,
            "sortBy": sort_by,
            "sortOrder": sort_order
        }
        return f"{self.BASE_URL}?{urllib.parse.urlencode(params)}"

    def fetch_papers(self, search_terms=None, max_results=10):
        url = self.build_query(search_terms=search_terms, max_results=max_results)
        print(f"[*] Querying arXiv API: {url}", file=sys.stderr)

        headers = {
            "User-Agent": "ArxivAgentRadar/1.0 (GovernedAgentEcosystem; Guelph, Ontario, Canada)"
        }

        req = urllib.request.Request(url, headers=headers)
        
        # Enforce rate limiting / politeness delay
        time.sleep(self.delay_seconds)

        with urllib.request.urlopen(req) as response:
            xml_data = response.read().decode("utf-8")

        return self.parse_feed(xml_data)

    def parse_feed(self, xml_string):
        root = ET.fromstring(xml_string)
        entries = root.findall(f"{ATOM_NS}entry")
        papers = []

        for entry in entries:
            id_url = entry.findtext(f"{ATOM_NS}id", "").strip()
            title = entry.findtext(f"{ATOM_NS}title", "").strip().replace("\n", " ")
            summary = entry.findtext(f"{ATOM_NS}summary", "").strip().replace("\n", " ")
            published = entry.findtext(f"{ATOM_NS}published", "").strip()
            updated = entry.findtext(f"{ATOM_NS}updated", "").strip()

            authors = []
            for author_node in entry.findall(f"{ATOM_NS}author"):
                name = author_node.findtext(f"{ATOM_NS}name", "").strip()
                if name:
                    authors.append(name)

            categories = []
            for cat_node in entry.findall(f"{ATOM_NS}category"):
                term = cat_node.attrib.get("term")
                if term:
                    categories.append(term)

            pdf_url = ""
            for link_node in entry.findall(f"{ATOM_NS}link"):
                if link_node.attrib.get("title") == "pdf" or link_node.attrib.get("type") == "application/pdf":
                    pdf_url = link_node.attrib.get("href", "")
                    break

            arxiv_id = id_url.split("/abs/")[-1] if "/abs/" in id_url else id_url

            papers.append({
                "arxiv_id": arxiv_id,
                "title": title,
                "authors": authors,
                "published": published,
                "updated": updated,
                "categories": categories,
                "summary": summary,
                "abs_url": id_url,
                "pdf_url": pdf_url
            })

        return papers

    def generate_markdown_report(self, papers, output_file=None):
        md = []
        md.append("# arXiv AI Agent Ecosystem Radar Report")
        md.append(f"**Generated:** {datetime.utcnow().strftime('%Y-%m-%d %H:%M:%S UTC')}")
        md.append(f"**Target Categories:** {', '.join(self.categories)}")
        md.append(f"**Total Papers Retrieved:** {len(papers)}\n")
        md.append("---\n")

        for idx, p in enumerate(papers, 1):
            md.append(f"### {idx}. [{p['title']}]({p['abs_url']})")
            md.append(f"- **arXiv ID:** `{p['arxiv_id']}` | [PDF Link]({p['pdf_url']})")
            md.append(f"- **Authors:** {', '.join(p['authors'][:5])}{' et al.' if len(p['authors']) > 5 else ''}")
            md.append(f"- **Categories:** `{', '.join(p['categories'])}`")
            md.append(f"- **Published:** {p['published'][:10]}")
            md.append(f"- **Executive Abstract:** {p['summary']}\n")

        report = "\n".join(md)
        if output_file:
            with open(output_file, "w", encoding="utf-8") as f:
                f.write(report)
        return report

if __name__ == "__main__":
    radar = ArxivAgentRadar(categories=["cs.AI", "cs.MA", "cs.CL"])
    query_terms = sys.argv[1:] if len(sys.argv) > 1 else ["autonomous agent", "multi-agent"]
    print(f"Executing arXiv search for terms: {query_terms}...")
    try:
        results = radar.fetch_papers(search_terms=query_terms, max_results=5)
        print(f"Retrieved {len(results)} papers successfully.")
        report = radar.generate_markdown_report(results, "arxiv_radar_latest.md")
        print("\n" + report[:1000] + "...\n")
    except Exception as e:
        print(f"Execution notice: {e}")

